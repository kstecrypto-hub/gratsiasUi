APP_ENV=production
APP_SECRET_KEY=
APP_TIMEZONE=Europe/Athens

ADMIN_EMAIL=
ADMIN_PASSWORD=

# Yeastar connection. Base URL must contain only scheme, host, and optional port.
YEASTAR_NAME=
YEASTAR_BASE_URL=
YEASTAR_CLIENT_ID=
YEASTAR_CLIENT_SECRET=
YEASTAR_DATE_FORMAT=MM/dd/yyyy HH:mm:ss
YEASTAR_PAGE_SIZE=500
YEASTAR_IGNORE_SSL_ERRORS=true
YEASTAR_ALLOW_HTTP=false
YEASTAR_USER_AGENT=YeastarCallAnalyzer/1.0

# Yeastar API paths
YEASTAR_AUTH_API_PATH=/openapi/v1.0
YEASTAR_SYSTEM_API_PATH=/openapi/v1.0
YEASTAR_EXTENSION_API_PATH=/openapi/v1.0
YEASTAR_CDR_API_PATH=/openapi/v2.0
YEASTAR_RECORDING_API_PATH=/openapi/v1.0

# Yeastar request behavior
YEASTAR_CONNECT_TIMEOUT_SECONDS=10
YEASTAR_READ_TIMEOUT_SECONDS=60
YEASTAR_DOWNLOAD_TIMEOUT_SECONDS=300
YEASTAR_TOKEN_REFRESH_SKEW_SECONDS=120
YEASTAR_TRANSIENT_RETRY_COUNT=1

# Optional fallback when no OpenAI API key has been saved through Settings.
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
OPENAI_DIARIZATION_MODEL=gpt-4o-transcribe-diarize
TRANSCRIPTION_LANGUAGE=el
TRANSCRIPTION_PIPELINE_DEFAULT=legacy-v1
TRANSCRIPTION_PIPELINE_V2_ENABLED=false

DATABASE_URL=
REDIS_URL=redis://redis:6379/0
POSTGRES_DB=yeastar
POSTGRES_USER=app
POSTGRES_PASSWORD=

DELETE_AUDIO_AFTER_TRANSCRIPTION=true
TRANSCRIPT_RETENTION_DAYS=90
MAX_PARALLEL_TRANSCRIPTIONS=3

# Deployment settings. Keep FRONTEND_ORIGIN aligned with the public address.
FRONTEND_ORIGIN=http://localhost:3000
SECURE_COOKIES=true
SESSION_TTL_SECONDS=28800
LOGIN_RATE_LIMIT=5/15minutes
STORAGE_ROOT=/app/storage
MAX_RECORDING_BYTES=524288000
MAX_UPLOAD_BYTES=25165824
